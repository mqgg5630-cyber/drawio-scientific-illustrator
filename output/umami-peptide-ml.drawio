        <mxCell id="block-3-flow-3" style="endArrow=none;html=1;rounded=0;strokeColor=#1F4E79;strokeWidth=1.5;exitX=0.5;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="block-3-glyph-s3" target="block-3-glyph-hex" />
