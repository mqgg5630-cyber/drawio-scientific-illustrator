        <mxCell id="block-3-desc" value="对接 + 动力学 + 感官&#10;高置信度 Top 序列" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
