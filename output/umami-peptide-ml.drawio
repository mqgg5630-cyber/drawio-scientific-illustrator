<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio-scientific-illustrator" agent="Arena-agent" version="24.7.17">
  <diagram id="umami-ml-workflow" name="Umami Peptide ML Screening">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ 标题区 ============ -->
        <mxCell id="title-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F2C4D;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1720" height="90" as="geometry" />
        </mxCell>
        <mxCell id="title-text" value="机器学习辅助筛选鲜味肽：从序列到味觉受体" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="35" width="1720" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" value="ML-assisted screening of umami peptides: from sequence encoding to T1R1/T1R3 receptor validation" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#BFD4F0;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="82" width="1720" height="30" as="geometry" />
        </mxCell>

        <!-- ============ 三个分区背景 ============ -->
        <mxCell id="panel-A-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F7FC;strokeColor=#0F2C4D;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="540" height="1010" as="geometry" />
        </mxCell>
        <mxCell id="panel-B-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF6EC;strokeColor=#B45309;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="600" height="1010" as="geometry" />
        </mxCell>
        <mxCell id="panel-C-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F8F1;strokeColor=#1F7A1F;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="150" width="540" height="1010" as="geometry" />
        </mxCell>

        <!-- 分区标题 -->
        <mxCell id="panel-A-title" value="A · 数据集与特征工程" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F2C4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="panel-B-title" value="B · 模型训练与性能对比" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="600" height="35" as="geometry" />
        </mxCell>
        <mxCell id="panel-C-title" value="C · 虚拟筛选与湿实验验证" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F7A1F;" vertex="1" parent="1">
          <mxGeometry x="1220" y="160" width="540" height="35" as="geometry" />
        </mxCell>

        <!-- ============ A 区：数据源 ============ -->
        <mxCell id="A-source-biopeptide" value="Biopep-UWM&#10;鲜味肽数据库&#10;已标注 312 条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2C4D;strokeWidth=1.5;fontSize=12;fontColor=#0F2C4D;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="A-source-umami" value="UMAMI 数据库&#10;感官评分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2C4D;strokeWidth=1.5;fontSize=12;fontColor=#0F2C4D;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="A-source-uniprot" value="UniProt / 文献&#10;非鲜味负样本 980 条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F2C4D;strokeWidth=1.5;fontSize=12;fontColor=#0F2C4D;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="120" height="70" as="geometry" />
        </mxCell>

        <!-- A 区：数据汇集节点 -->
        <mxCell id="A-pool" value="序列与标签池&#10;1 292 条 / 长度 2–10" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D6E4F5;strokeColor=#0F2C4D;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#0F2C4D;" vertex="1" parent="1">
          <mxGeometry x="180" y="340" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- A 区：特征工程三路 -->
        <mxCell id="A-feat-seq" value="① 序列编码&#10;AAC / CTD / AAS&#10;one-hot · BLOSUM62" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="A-feat-phys" value="② 理化描述符&#10;疏水 · 电荷 · 体积&#10;128 维 RDKit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="240" y="470" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="A-feat-emb" value="③ 预训练嵌入&#10;ESM-2 / ProtT5&#10;1280 维向量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- A 区：训练/验证/测试切分 -->
        <mxCell id="A-split-train" value="训练集&#10;70%&#10;N=914" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#0F2C4D;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="130" height="65" as="geometry" />
        </mxCell>
        <mxCell id="A-split-val" value="验证集&#10;15%&#10;N=196" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#60A5FA;strokeColor=#0F2C4D;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="240" y="600" width="130" height="65" as="geometry" />
        </mxCell>
        <mxCell id="A-split-test" value="独立测试集&#10;15%&#10;N=182" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#0F2C4D;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#0F2C4D;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="140" height="65" as="geometry" />
        </mxCell>

        <!-- A 区：评估策略小框 -->
        <mxCell id="A-eval" value="评估协议：5-折交叉验证 + 独立测试集&#10;指标：Accuracy · AUC · MCC · F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontColor=#7C2D12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="500" height="55" as="geometry" />
        </mxCell>

        <!-- A 区：箭头 -->
        <mxCell id="A-e1" style="endArrow=classic;html=1;rounded=0;strokeColor=#0F2C4D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-source-biopeptide" target="A-pool" />
        <mxCell id="A-e2" style="endArrow=classic;html=1;rounded=0;strokeColor=#0F2C4D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-source-umami" target="A-pool" />
        <mxCell id="A-e3" style="endArrow=classic;html=1;rounded=0;strokeColor=#0F2C4D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-source-uniprot" target="A-pool" />
        <mxCell id="A-e4" style="endArrow=classic;html=1;rounded=0;strokeColor=#3B82F6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-pool" target="A-feat-seq" />
        <mxCell id="A-e5" style="endArrow=classic;html=1;rounded=0;strokeColor=#3B82F6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-pool" target="A-feat-phys" />
        <mxCell id="A-e6" style="endArrow=classic;html=1;rounded=0;strokeColor=#3B82F6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-pool" target="A-feat-emb" />
        <mxCell id="A-e7" style="endArrow=classic;html=1;rounded=0;strokeColor=#0F2C4D;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="A-feat-seq" target="A-split-train" />
        <mxCell id="A-e8" style="endArrow=classic;html=1;rounded=0;strokeColor=#0F2C4D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-feat-phys" target="A-split-val" />
        <mxCell id="A-e9" style="endArrow=classic;html=1;rounded=0;strokeColor=#0F2C4D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A-feat-emb" target="A-split-test" />
        <mxCell id="A-e10" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="A-split-test" target="A-eval" />
        <mxCell id="A-e11" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="A-split-val" target="A-eval" />

        <!-- A 区底部说明 -->
        <mxCell id="A-note" value="注：所有细胞、形状、文字、连线均为独立可编辑节点&#10;在 draw.io 中打开后可直接拖拽 / 双击修改 / 调色" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#475569;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1080" width="500" height="50" as="geometry" />
        </mxCell>

        <!-- A → B 的总连线 -->
        <mxCell id="AB-e1" value="特征向量 + 标签" style="endArrow=classic;html=1;rounded=0;strokeColor=#0F2C4D;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F2C4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="A-split-train" target="B-input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ B 区：模型 ============ -->
        <!-- B 区输入 -->
        <mxCell id="B-input" value="融合特征输入&#10;X ∈ ℝ^(1292×1556)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="520" height="50" as="geometry" />
        </mxCell>

        <!-- 5 个模型框（从左到右排列） -->
        <mxCell id="B-model-RF" value="随机森林&#10;Random Forest&#10;n=600, depth=20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="310" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B-model-SVM" value="SVM (RBF)&#10;γ=0.05, C=4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="820" y="310" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B-model-XGB" value="XGBoost&#10;lr=0.05, 500 轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B-model-CNN" value="1D-CNN&#10;Conv→Pool→Dense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="400" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B-model-TFM" value="Transformer&#10;8-head attention&#10;微调 ESM-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="820" y="400" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B-model-STACK" value="Stacking 集成&#10;元学习器 = LR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#B45309;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- B 区 → 性能图 -->
        <mxCell id="B-perf-title" value="独立测试集性能对比" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="520" height="25" as="geometry" />
        </mxCell>

        <!-- 性能图坐标轴 -->
        <mxCell id="B-axis-y" value="" style="endFill=0;html=1;rounded=0;strokeColor=#7C2D12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="700" y="540" width="10" height="180" as="geometry" />
        </mxCell>
        <mxCell id="B-axis-x" value="" style="endFill=0;html=1;rounded=0;strokeColor=#7C2D12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="700" y="720" width="430" height="10" as="geometry" />
        </mxCell>

        <!-- 5 个模型的 3 个柱（Acc/AUC/MCC） - 简化为单柱示意（综合得分） -->
        <mxCell id="B-bar-RF" value="RF&#10;0.86" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#7C2D12;strokeWidth=1;fontSize=10;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="725" y="640" width="50" height="80" as="geometry" />
        </mxCell>
        <mxCell id="B-bar-SVM" value="SVM&#10;0.83" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#7C2D12;strokeWidth=1;fontSize=10;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="800" y="670" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="B-bar-XGB" value="XGB&#10;0.89" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#7C2D12;strokeWidth=1;fontSize=10;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="875" y="615" width="50" height="105" as="geometry" />
        </mxCell>
        <mxCell id="B-bar-CNN" value="CNN&#10;0.91" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCD34D;strokeColor=#7C2D12;strokeWidth=1;fontSize=10;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="950" y="595" width="50" height="125" as="geometry" />
        </mxCell>
        <mxCell id="B-bar-TFM" value="TFM&#10;0.92" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCD34D;strokeColor=#7C2D12;strokeWidth=1;fontSize=10;fontStyle=1;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="1025" y="585" width="50" height="135" as="geometry" />
        </mxCell>
        <mxCell id="B-bar-STACK" value="Stack&#10;0.94★" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#34D399;strokeColor=#065F46;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="1100" y="565" width="50" height="155" as="geometry" />
        </mxCell>

        <mxCell id="B-axis-label" value="综合得分（Acc · AUC · MCC 平均）" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="730" width="520" height="20" as="geometry" />
        </mxCell>

        <!-- B 区：SHAP 可解释性 -->
        <mxCell id="B-shap" value="SHAP 可解释性分析&#10;关键特征：AAS（Asp · Glu）· 疏水性 · 末端带电" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="780" width="520" height="55" as="geometry" />
        </mxCell>

        <!-- B 区：模型 → 集成 -->
        <mxCell id="B-e1" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-input" target="B-model-RF" />
        <mxCell id="B-e2" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-input" target="B-model-SVM" />
        <mxCell id="B-e3" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-input" target="B-model-XGB" />
        <mxCell id="B-e4" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-input" target="B-model-CNN" />
        <mxCell id="B-e5" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-input" target="B-model-TFM" />
        <mxCell id="B-e6" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-model-RF" target="B-model-STACK" />
        <mxCell id="B-e7" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-model-SVM" target="B-model-STACK" />
        <mxCell id="B-e8" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-model-XGB" target="B-model-STACK" />
        <mxCell id="B-e9" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-model-CNN" target="B-model-STACK" />
        <mxCell id="B-e10" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;" edge="1" parent="1" source="B-model-TFM" target="B-model-STACK" />

        <!-- B → C 总连线 -->
        <mxCell id="BC-e1" value="最佳集成模型&#10;AUC=0.94" style="endArrow=classic;html=1;rounded=0;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7C2D12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="B-model-STACK" target="C-screen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- B 区底部图例 -->
        <mxCell id="B-legend-red" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="870" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="B-legend-red-text" value="传统 ML（RF/SVM/XGB）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="665" y="870" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="B-legend-yellow" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCD34D;strokeColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="640" y="900" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="B-legend-yellow-text" value="深度模型（CNN/Transformer）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#7C2D12;" vertex="1" parent="1">
          <mxGeometry x="665" y="900" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="B-legend-green" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#34D399;strokeColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="640" y="930" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="B-legend-green-text" value="Stacking 集成（最终模型 ★）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#065F46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="665" y="930" width="240" height="20" as="geometry" />
        </mxCell>

        <!-- B 区底部说明 -->
