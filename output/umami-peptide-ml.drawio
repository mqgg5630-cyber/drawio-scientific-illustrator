          <mxGeometry x="1160" y="800" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="caption-3-desc" value="对 5 240 条候选虚拟筛选，得到 Top 23；经 T1R1 / T1R3 对接（ΔG ≤ −7.8 kcal/mol）、100 ns MD 与感官复现（87%）验证。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
