        <mxCell id="caption-2" value="② 机器学习" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="660" y="800" width="480" height="20" as="geometry" />
        </mxCell>
        <mxCell id="caption-2-desc" value="5 基模型（RF / SVM / XGBoost / 1D-CNN / Transformer）经 Stacking 集成；测试集 AUC = 0.943，优于任一基模型。SHAP 显示 N 端 E、C 端 D、疏水性、肽长 ≤ 4 是关键特征。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="660" y="822" width="480" height="56" as="geometry" />
        </mxCell>

