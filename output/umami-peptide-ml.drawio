        <mxCell id="block-2-desc" value="序列 → 特征 → 集成模型&#10;5 基模型 + Stacking ★" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
