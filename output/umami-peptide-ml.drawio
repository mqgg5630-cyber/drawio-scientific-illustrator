        <mxCell id="caption-1-desc" value="n = 1 292 条已标注肽（鲜味 312 · 非鲜味 980），长度 2–10，分层 70 / 15 / 15 切分。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
